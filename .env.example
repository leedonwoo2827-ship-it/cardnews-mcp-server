# ── LLM 공급자 ───────────────────────────────────────────────────────
# anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic 사용 시
ANTHROPIC_API_KEY=
# (선택) Anthropic 호환 게이트웨이 URL
# ANTHROPIC_BASE_URL=

# OpenAI 사용 시
OPENAI_API_KEY=
# (선택) OpenAI 호환 게이트웨이 URL — 사내 LiteLLM 프록시 등.
#   예: OPENAI_BASE_URL=http://<your-litellm-proxy-host>:4000/v1 + MODEL=<your-model>
# OPENAI_BASE_URL=

# 모델 직접 지정(선택). 비우면 공급자별 기본값 사용.
#   anthropic 기본: claude-sonnet-4-6
#   openai    기본: gpt-4o
MODEL=

# ── 출력 ────────────────────────────────────────────────────────────
# 생성된 HTML/PNG 가 저장되는 기본 디렉터리 (도구 인자로 덮어쓸 수 있음)
OUTPUT_DIR=./output
